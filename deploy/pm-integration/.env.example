# Edge (Caddy) settings. Defaults in the Caddyfile match these values, so the
# edge runs without a .env file. Caddy does not read this file by itself:
#   set -a; . deploy/pm-integration/.env; set +a

# Port the combined edge listens on.
EDGE_PORT=7000

# Hostnames routed by the edge.
PASEO_HOST=paseo.localhost
PM_HOST=pm.localhost

# Browser-visible origins through the edge.
PASEO_ORIGIN=http://paseo.localhost:7000
PM_PUBLIC_ORIGIN=http://pm.localhost:7000

# Loopback upstreams. These are plain HTTP.
PASEO_UPSTREAM=127.0.0.1:6768
PM_UPSTREAM=127.0.0.1:3224

# Optional TLS (see README). Leave commented for plain-HTTP localhost dev.
# EDGE_HOSTS=pm.example.test,paseo.example.test
# EDGE_TLS=internal            # or an ACME e-mail address

# PM's own server configuration (not read by Caddy):
# - PM's PUBLIC_ORIGIN must equal PM_PUBLIC_ORIGIN above, exactly.
# - Keep CORS disabled: the edge provides same-origin access per host. Never
#   add wildcard CORS at the edge or in PM.
# - PM session cookies belong to the PM host. Do not share them with (or send
#   them from) the Paseo host.
